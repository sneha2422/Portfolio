rules_version = '2';

// ============================================================================
//  Testimonials rules
//
//  NOTE ON SECURITY:
//  The admin page (app/admin/testimonials) uses the client SDK with a
//  hardcoded password and is NOT authenticated with Firebase Auth. For the
//  approve/delete buttons to work, update & delete must be permitted below.
//  This means these rules are FUNCTIONAL but NOT fully secure — anyone who
//  knows the collection could technically update/delete docs.
//
//  RECOMMENDED HARDENING (later): add Firebase Auth, sign the admin in, and
//  change `update, delete` to `if request.auth != null`. The stricter lines
//  are included commented-out below.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /testimonials/{id} {
      // Anyone can read (public site filters to approved == true in its query;
      // the admin page needs to read pending ones to moderate them).
      allow read: if true;

      // Anyone can submit, but only as an UNapproved testimonial.
      allow create: if request.resource.data.approved == false
                    && request.resource.data.quote is string
                    && request.resource.data.author is string;

      // Moderation — required by the unauthenticated client admin page.
      allow update, delete: if true;

      // --- Secure version (use once Firebase Auth is added to the admin page) ---
      // allow update, delete: if request.auth != null;
    }

    // Lock everything else down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
